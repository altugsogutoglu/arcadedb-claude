{
  "name": "arcadedb-claude",
  "version": "0.3.0",
  "private": true,
  "description": "ArcadeDB-powered graph intelligence suite for Claude Code: agent memory, code indexing, Obsidian sync, and a Claude Code plugin.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/agent-memory -w packages/code-indexer && npm run build -w packages/claude-skills -w packages/obsidian-sync",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "publish:all": "npm publish --workspaces --access public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altugsogutoglu/arcadedb-claude.git"
  },
  "author": {
    "name": "Altug Sogutoglu",
    "url": "https://github.com/altugsogutoglu"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "overrides": {
    "vite": "8.0.16",
    "esbuild": "0.28.1"
  }
}
