{
  "name": "arcadedb-code-indexer",
  "version": "0.4.1",
  "description": "Walks a code repo and writes its structure (modules, files, imports) into an ArcadeDB graph. Part of the arcadedb-claude suite.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arcadedb-index": "./dist/bin/arcadedb-index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/writer.test.ts --exclude tests/indexer.test.ts --exclude 'tests/cli/**'",
    "test:watch": "vitest",
    "cli": "tsx bin/arcadedb-index.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "arcadedb-agent-memory": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altugsogutoglu/arcadedb-claude.git",
    "directory": "packages/code-indexer"
  },
  "publishConfig": {
    "access": "public"
  }
}
